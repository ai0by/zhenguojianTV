<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 系统启动画面（SplashScreen API）。
     0.8.11：用户反馈"开屏闪了一下以前的加载页面"。
     系统启动画面不受 windowBackground 控制，默认会画**应用图标**（那个白底品牌图），
     和开屏美术图完全不是一回事，中间再切一次就是明显的闪跳。
     这里把系统启动画面压成纯色底 + 透明图标，视觉上就是"开屏图直接出现"。 -->
<resources>
    <style name="LaunchTheme" parent="AppSystemBarTheme">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="NormalTheme" parent="AppSystemBarTheme" />
</resources>
